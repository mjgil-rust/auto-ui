            geometry: WindowGeometry {
                x: 100,
                y: 200,
                width: 1024,
                height: 768,
            },
            z_order: 5,
        };
        let cloned = state.clone();
        assert_eq!(cloned.geometry.width, state.geometry.width);
        assert_eq!(cloned.z_order, state.z_order);
    }
}
